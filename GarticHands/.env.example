# Copy to `.env` (same folder) before running `docker compose up`.
# All values have safe defaults, so an empty .env works too.

# Host port the web app (nginx) is served on. Open http://localhost:WEB_PORT
WEB_PORT=8080

# Host port the API / Socket.IO server is exposed on. For debugging only —
# the web app reaches the server through the nginx proxy, not this port.
SERVER_PORT=3000

# Base URL the browser uses for API calls.
#   (empty)               -> same-origin; nginx proxies /rooms and /socket.io  [recommended for Docker]
#   http://localhost:3000 -> bypass the proxy and hit the server directly
VITE_API_URL=
