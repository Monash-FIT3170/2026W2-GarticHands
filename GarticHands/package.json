{
  "name": "gartichands",
  "version": "1.0.0",
  "private": true,
  "description": "Gartic Hands multiplayer drawing game with hand-tracking input",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w @gartichands/server\" \"npm run dev -w @gartichands/client\"",
    "dev:client": "npm run dev -w @gartichands/client",
    "dev:server": "npm run dev -w @gartichands/server",
    "build": "npm run build -w @gartichands/client",
    "start": "concurrently -n server,client -c blue,magenta \"npm run start -w @gartichands/server\" \"npm run preview -w @gartichands/client\"",
    "lint": "npm run lint -w @gartichands/client",
    "test:e2e": "playwright test --config=e2e-tests/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e-tests/playwright.config.ts --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "concurrently": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monash-FIT3170/2026W2-GarticHands.git"
  },
  "bugs": {
    "url": "https://github.com/Monash-FIT3170/2026W2-GarticHands/issues"
  },
  "homepage": "https://github.com/Monash-FIT3170/2026W2-GarticHands#readme",
  "license": "ISC"
}